[Unit]
Description=ySupport Discord bot
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=ysupport
Group=ysupport
WorkingDirectory=/root/bots/discord/ysupport
EnvironmentFile=/root/bots/discord/ysupport/.env
Environment=PYTHON_DOTENV_DISABLED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/root/bots/discord/ysupport/scripts/run_ysupport_host.sh

StateDirectory=ysupport-codex
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/root/bots/discord/ysupport
BindReadOnlyPaths=/root/.nvm/versions/node/v22.20.0
InaccessiblePaths=/root/bots/discord/ysupport/.env

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

Restart=on-failure
RestartSec=30
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
